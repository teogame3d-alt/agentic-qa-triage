# Safe default: runs the full workflow without sending data to an external model.
AGENT_PROVIDER=demo

# Required only when AGENT_PROVIDER=openai.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini

# Local zero-setup fallback. Docker Compose overrides this with PostgreSQL.
DATABASE_URL=sqlite:///./agentic_qa_triage.db

# Guardrails for runtime and context size.
MAX_AGENT_TURNS=4
MAX_INPUT_CHARS=12000

# Optional current rates, in USD per one million tokens.
# They are deliberately not hardcoded because model pricing changes.
OPENAI_INPUT_USD_PER_MILLION=
OPENAI_CACHED_INPUT_USD_PER_MILLION=
OPENAI_OUTPUT_USD_PER_MILLION=
